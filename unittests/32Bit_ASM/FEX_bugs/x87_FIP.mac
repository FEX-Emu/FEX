; FEX-Emu had a bug where FIP wasn't being calculated for ALU operations.
; Not all x87 instructions update FIP, but run through the suite just in case.
; Which will catch any instructions accidentally setting FIP, but shouldn't be.
; FDP isn't calculated here, but keep it around in-case we care in the future.

; Split/Second (SteamID 297860) had a SecuROM implementation that used this for some form of anti-tamper/cheat.

; Follow the formula:
; - finit
; - <inst>
; - get_result <expected FIP>, <expected FDP>
; Or:
; - <load inputs>
; - basic_op <instruction>

%macro get_result 2
  mov eax, 0x41424344
  mov ebx, 0

  fsave [rel .data]
  ; Load FIP.
  mov eax, [rel .data + 0xc]
  ; Load FDP
  ; XXX: Not validated in this test.
  ; mov ebx, [rel .data + 0x14]

  mov dword [ecx + 0], eax
  mov dword [ecx + 4], ebx
  cmp eax, %1
  jne %%.bad_end
  cmp ebx, %2
  jne %%.bad_end

  add ecx, 8
  ; Reset the state.
  finit
  jmp %%.good
  %%.bad_end:
  mov edx, 1
  ud2
  %%.good:
%endmacro

%macro basic_op 1
  lea esi, [rel %%.local_op]
  %%.local_op:
  %1
  get_result esi, 0
%endmacro

lea ecx, [rel .data_results]
mov edx, 0

